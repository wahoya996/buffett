# Maintainer: <your name> <your email>
# 东方财富 Choice金融终端 —— Arch Linux 重打包脚本
# 源文件: ChoiceSetup_uos_x86.deb (统信 UOS / Debian amd64 安装包)
#
# 说明:
#   该安装包是闭源的 Qt5 + CEF 桌面程序, 自带 Qt 5.14.2 / ICU 56 / OpenSSL 1.1 等运行库
#   (位于 files/lib 下, 通过 $ORIGIN RUNPATH 相对定位, 与安装路径无关).
#   仅有 QsExcelWebJs_1.0.0/index.html 一处硬编码了 /opt/apps/com.eastmoney.choice/files/,
#   因此本包沿用原始安装路径 /opt/apps/com.eastmoney.choice 以避免功能异常.

pkgname=eastmoney-choice
pkgver=9.14.0.1
pkgrel=1
pkgdesc="东方财富Choice金融终端（专业金融数据与分析终端，UOS deb 重打包）"
arch=('x86_64')
url='https://choice.eastmoney.com/'
license=('LicenseRef-Proprietary')  # 闭源商业软件

# 程序自带的私有 .so 均位于 files/lib, 通过 $ORIGIN 加载;
# 以下为二进制所链接的系统级运行库依赖 (由 ldd / readelf -d 分析得出).
depends=(
  'alsa-lib'        # libasound.so.2
  'at-spi2-core'    # libatk / libatk-bridge / libatspi
  'cairo'           # libcairo.so.2
  'dbus'            # libdbus-1.so.3
  'expat'           # libexpat.so.1
  'fontconfig'      # 字体渲染
  'gdk-pixbuf2'     # libgdk_pixbuf-2.0.so.0
  'glib2'           # libglib / libgio / libgobject / libgmodule
  'gtk3'            # libgtk-3 / libgdk-3
  'libcups'         # libcups.so.2
  'libdrm'          # libdrm.so.2
  'libx11'          # libX11 / libX11-xcb
  'libxcb'          # libxcb.so.1 / libxcb-xkb 等
  'libxcomposite'   # libXcomposite.so.1
  'libxdamage'      # libXdamage.so.1
  'libxext'         # libXext.so.6
  'libxfixes'       # libXfixes.so.3
  'libxi'           # libXi.so.6
  'libxkbcommon'    # libxkbcommon / libxkbcommon-x11
  'libxrandr'       # libXrandr.so.2
  'mesa'            # libGL.so.1 / libgbm.so.1
  'nspr'            # libnspr4.so
  'nss'             # libnss3 / libnssutil3 / libsmime3
  'pango'           # libpango / libpangocairo
  'zlib'            # libz.so.1
)

makedepends=('libarchive')  # bsdtar 解包 .deb

# 中文字体为界面/行情显示所必需 (任选其一, 推荐 noto-fonts-cjk)
optdepends=(
  'noto-fonts-cjk: 中文界面与行情数据所需 CJK 字体（推荐）'
  'wqy-microhei: 备选中文黑体'
)

# 闭源二进制, 禁止 makepkg 二次 strip (避免破坏 Qt 插件/CEF 符号)
options=('!strip')

# 请把 ChoiceSetup_uos_x86.deb 放到与本 PKGBUILD 相同目录
source=('ChoiceSetup_uos_x86.deb')
sha256sums=('306c54b2b28c6f2a446bd0e54adc0aca30a1c659756adb47675024f22ccf5c7a')

install=eastmoney-choice.install

prepare() {
  cd "$srcdir"
  # .deb 本质是 ar 归档, 内含 control.tar.xz / data.tar.xz / debian-binary / sign
  mkdir -p deb
  bsdtar -xf "$srcdir/ChoiceSetup_uos_x86.deb" -C deb
}

package() {
  cd "$srcdir"

  # 保证 bsdtar 以 UTF-8 处理包内中文文件名 (fakeroot 下默认 C locale 会报转换警告)
  export LC_ALL=C.UTF-8

  # 1) 直接将 data.tar.xz 展开到包目录 (保留 /opt/apps/... 与 /usr/share 原始布局)
  bsdtar -xf deb/data.tar.xz -C "$pkgdir"

  # 2) 安装许可证
  install -Dm644 \
    "$pkgdir/opt/apps/com.eastmoney.choice/files/license.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/license.txt"

  # 3) 启动脚本: 先切换到程序目录再执行 (保证 $ORIGIN 相对资源/插件正常加载)
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/emchoice" <<'EOF'
#!/bin/sh
appdir=/opt/apps/com.eastmoney.choice/files
if [ ! -x "$appdir/EMChoice" ]; then
    echo "emchoice: 未找到可执行文件 $appdir/EMChoice" >&2
    exit 1
fi
cd "$appdir" || exit 1
exec ./EMChoice "$@"
EOF

  # 4) 重写 .desktop 文件: 使用标准图标名 + 启动脚本
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/com.eastmoney.choice.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Choice金融终端
Name[en]=Choice Financial Terminal
Comment=专业金融数据与分析终端
Comment[en]=Professional financial data & analytics terminal
Exec=emchoice
Icon=com.eastmoney.choice
Terminal=false
Categories=Office;Finance;
MimeType=x-scheme-handler/EMChoice;
EOF
}
